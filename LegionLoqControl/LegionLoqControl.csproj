<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IncludeBrokerArtifacts Condition="'$(IncludeBrokerArtifacts)' == ''">true</IncludeBrokerArtifacts>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\LegionLoqControl.Application\LegionLoqControl.Application.csproj" />
    <ProjectReference Include="..\src\LegionLoqControl.Broker\LegionLoqControl.Broker.csproj"
                      Condition="'$(IncludeBrokerArtifacts)' == 'true'"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\src\LegionLoqControl.Contracts\LegionLoqControl.Contracts.csproj" />
    <ProjectReference Include="..\src\LegionLoqControl.Domain\LegionLoqControl.Domain.csproj" />
    <ProjectReference Include="..\src\LegionLoqControl.Infrastructure.Windows\LegionLoqControl.Infrastructure.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\logo.ico" />
    <None Include="Assets\logo.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <Target Name="ResolveBrokerOutputDirectory">
    <PropertyGroup>
      <_BrokerTfDir>$(MSBuildProjectDirectory)\..\src\LegionLoqControl.Broker\bin\$(Configuration)\$(TargetFramework)\</_BrokerTfDir>
      <_BrokerRidDir Condition="'$(RuntimeIdentifier)' != ''">$(_BrokerTfDir)$(RuntimeIdentifier)\</_BrokerRidDir>
      <_BrokerDir Condition="'$(_BrokerRidDir)' != '' AND Exists('$(_BrokerRidDir)LegionLoqControl.Broker.exe')">$(_BrokerRidDir)</_BrokerDir>
      <_BrokerDir Condition="'$(_BrokerDir)' == ''">$(_BrokerTfDir)</_BrokerDir>
    </PropertyGroup>
  </Target>
  <Target Name="CopyBrokerArtifacts"
          AfterTargets="Build"
          DependsOnTargets="ResolveBrokerOutputDirectory"
          Condition="'$(IncludeBrokerArtifacts)' == 'true'">
    <ItemGroup>
      <BrokerArtifact Include="$(_BrokerDir)LegionLoqControl.Broker.exe" />
      <BrokerArtifact Include="$(_BrokerDir)LegionLoqControl.Broker.dll" />
      <BrokerArtifact Include="$(_BrokerDir)LegionLoqControl.Broker.deps.json" />
      <BrokerArtifact Include="$(_BrokerDir)LegionLoqControl.Broker.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(BrokerArtifact)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyBrokerArtifactsOnPublish"
          AfterTargets="Publish"
          DependsOnTargets="ResolveBrokerOutputDirectory"
          Condition="'$(IncludeBrokerArtifacts)' == 'true'">
    <ItemGroup>
      <BrokerPublishArtifact Include="$(_BrokerDir)LegionLoqControl.Broker.exe" />
      <BrokerPublishArtifact Include="$(_BrokerDir)LegionLoqControl.Broker.dll" />
      <BrokerPublishArtifact Include="$(_BrokerDir)LegionLoqControl.Broker.deps.json" />
      <BrokerPublishArtifact Include="$(_BrokerDir)LegionLoqControl.Broker.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(BrokerPublishArtifact)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
