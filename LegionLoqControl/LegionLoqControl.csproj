<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IncludeBrokerArtifacts Condition="'$(IncludeBrokerArtifacts)' == ''">true</IncludeBrokerArtifacts>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\LegionLoqControl.Application\LegionLoqControl.Application.csproj" />
    <ProjectReference Include="..\src\LegionLoqControl.Broker\LegionLoqControl.Broker.csproj"
                      Condition="'$(IncludeBrokerArtifacts)' == 'true'"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\src\LegionLoqControl.Contracts\LegionLoqControl.Contracts.csproj" />
    <ProjectReference Include="..\src\LegionLoqControl.Domain\LegionLoqControl.Domain.csproj" />
    <ProjectReference Include="..\src\LegionLoqControl.Infrastructure.Windows\LegionLoqControl.Infrastructure.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <Target Name="CopyBrokerArtifacts"
          AfterTargets="Build"
          Condition="'$(IncludeBrokerArtifacts)' == 'true'">
    <ItemGroup>
      <BrokerArtifact Include="$(MSBuildProjectDirectory)\..\src\LegionLoqControl.Broker\bin\$(Configuration)\$(TargetFramework)\LegionLoqControl.Broker.exe" />
      <BrokerArtifact Include="$(MSBuildProjectDirectory)\..\src\LegionLoqControl.Broker\bin\$(Configuration)\$(TargetFramework)\LegionLoqControl.Broker.dll" />
      <BrokerArtifact Include="$(MSBuildProjectDirectory)\..\src\LegionLoqControl.Broker\bin\$(Configuration)\$(TargetFramework)\LegionLoqControl.Broker.deps.json" />
      <BrokerArtifact Include="$(MSBuildProjectDirectory)\..\src\LegionLoqControl.Broker\bin\$(Configuration)\$(TargetFramework)\LegionLoqControl.Broker.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(BrokerArtifact)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
