<Window x:Class="LegionLoqControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:vm="clr-namespace:LegionLoqControl.ViewModels"
        Title="Legion + LOQ Control"
        Width="1080"
        Height="720"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="StateCardTemplate"
                      DataType="{x:Type vm:HardwareStateCardViewModel}">
            <Border Style="{StaticResource SurfaceBorderStyle}"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="StateMarker"
                            Grid.Column="0"
                            Margin="0,1,0,1"
                            Background="{StaticResource MutedTextBrush}"
                            CornerRadius="2" />

                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource EyebrowTextStyle}"
                                   Text="{Binding Label}" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,4,0,20"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding Description}" />
                        <TextBlock Grid.Row="2"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Text="{Binding Value}" />
                        <TextBlock Grid.Row="3"
                                   Margin="0,8,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding Detail}" />
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Success}">
                    <Setter TargetName="StateMarker"
                            Property="Background"
                            Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Warning}">
                    <Setter TargetName="StateMarker"
                            Property="Background"
                            Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Error}">
                    <Setter TargetName="StateMarker"
                            Property="Background"
                            Value="{StaticResource FailureBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Unavailable}">
                    <Setter TargetName="StateMarker"
                            Property="Background"
                            Value="{StaticResource BorderBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CapabilityItemTemplate"
                      DataType="{x:Type vm:CapabilityItemViewModel}">
            <Grid Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock Margin="0,3,16,0"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding EvidenceCode}" />
                </StackPanel>
                <TextBlock x:Name="SupportText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Style="{StaticResource EyebrowTextStyle}"
                           Text="{Binding Support}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Success}">
                    <Setter TargetName="SupportText"
                            Property="Foreground"
                            Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Warning}">
                    <Setter TargetName="SupportText"
                            Property="Foreground"
                            Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ProfilePreviewItemTemplate"
                      DataType="{x:Type vm:ProfilePreviewItemViewModel}">
            <Border Margin="0,0,0,8"
                    Padding="16,14"
                    Style="{StaticResource SurfaceBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="PreviewMarker"
                            Grid.Column="0"
                            Margin="0,1,0,1"
                            Background="{StaticResource MutedTextBrush}"
                            CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="14,0,20,0">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Feature}" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding Detail}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource EyebrowTextStyle}"
                                   Text="CURRENT" />
                        <TextBlock Margin="0,3,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding Current}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3"
                               Margin="16,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="→" />
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource EyebrowTextStyle}"
                                   Text="DRAFT" />
                        <TextBlock Margin="0,3,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding Desired}" />
                    </StackPanel>
                    <TextBlock x:Name="PreviewStatus"
                               Grid.Column="5"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource EyebrowTextStyle}"
                               Text="{Binding Status}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Success}">
                    <Setter TargetName="PreviewMarker"
                            Property="Background"
                            Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="PreviewStatus"
                            Property="Foreground"
                            Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Warning}">
                    <Setter TargetName="PreviewMarker"
                            Property="Background"
                            Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="PreviewStatus"
                            Property="Foreground"
                            Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Error}">
                    <Setter TargetName="PreviewMarker"
                            Property="Background"
                            Value="{StaticResource FailureBrush}" />
                    <Setter TargetName="PreviewStatus"
                            Property="Foreground"
                            Value="{StaticResource FailureBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Unavailable}">
                    <Setter TargetName="PreviewMarker"
                            Property="Background"
                            Value="{StaticResource BorderBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <TabControl Background="{StaticResource CanvasBrush}"
                BorderThickness="0">
        <TabItem Margin="32,0,0,0"
                 Header="DASHBOARD"
                 Style="{StaticResource NavigationTabItemStyle}">
            <ScrollViewer Background="{StaticResource CanvasBrush}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,28"
              Background="{StaticResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}"
                               Text="LEGION + LOQ CONTROL / READ-ONLY REBUILD" />
                    <TextBlock Margin="0,6,0,0"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Text="{Binding DeviceName}" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding DeviceMetadata}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Right"
                               Style="{StaticResource EyebrowTextStyle}"
                               Text="LOCAL · NO TELEMETRY" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding InventoryStatus}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,0,0,28"
                    Style="{StaticResource SurfaceBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BannerMarker"
                            Grid.Column="0"
                            CornerRadius="6,0,0,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BannerState}"
                                                 Value="{x:Static vm:DashboardStateKind.Success}">
                                        <Setter Property="Background"
                                                Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BannerState}"
                                                 Value="{x:Static vm:DashboardStateKind.Error}">
                                        <Setter Property="Background"
                                                Value="{StaticResource FailureBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,16">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding BannerTitle}" />
                        <TextBlock Margin="0,4,16,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding BannerMessage}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Margin="16"
                            VerticalAlignment="Center"
                            automation:AutomationProperties.Name="Read current hardware state using the elevated broker"
                            Command="{Binding RefreshHardwareStateCommand}"
                            Content="{Binding RefreshButtonText}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Opens one Windows elevation prompt for a read-only snapshot" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Current hardware state" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Values are evidence, not controls. Refresh requires explicit elevation." />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Bottom"
                           Style="{StaticResource EyebrowTextStyle}"
                           Text="{Binding LastUpdated, StringFormat=LAST VERIFIED · {0}}" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,6,6"
                                Content="{Binding Battery}"
                                ContentTemplate="{StaticResource StateCardTemplate}" />
                <ContentControl Grid.Row="0"
                                Grid.Column="1"
                                Margin="6,0,0,6"
                                Content="{Binding Thermal}"
                                ContentTemplate="{StaticResource StateCardTemplate}" />
                <ContentControl Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,6,6,0"
                                Content="{Binding DisplayOverdrive}"
                                ContentTemplate="{StaticResource StateCardTemplate}" />
                <ContentControl Grid.Row="1"
                                Grid.Column="1"
                                Margin="6,6,0,0"
                                Content="{Binding IntegratedGpu}"
                                ContentTemplate="{StaticResource StateCardTemplate}" />
            </Grid>

            <Border Grid.Row="4"
                    Padding="20,18"
                    Style="{StaticResource SurfaceBorderStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="Capability evidence" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Candidate means an interface exists; it does not claim verified support." />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource EyebrowTextStyle}"
                                   Text="SERIAL-FREE INVENTORY" />
                    </Grid>

                    <Border Style="{StaticResource ThinSeparatorStyle}" />

                    <ItemsControl ItemsSource="{Binding Capabilities}"
                                  ItemTemplate="{StaticResource CapabilityItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,24,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="PROFILE PREVIEW"
                 Style="{StaticResource NavigationTabItemStyle}">
            <ScrollViewer Background="{StaticResource CanvasBrush}"
                          DataContext="{Binding ProfileWorkspace}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="32,24,32,28"
                      Background="{StaticResource CanvasBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}"
                                       Text="PROFILE PREVIEW / READ-ONLY PLANNING" />
                            <TextBlock Margin="0,6,0,0"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Text="{Binding DataContext.DeviceName, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding DataContext.DeviceMetadata, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource EyebrowTextStyle}"
                                       Text="LOCAL DRAFTS · NO APPLY PATH" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="No profile action requests elevation" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,0,0,28"
                            Style="{StaticResource SurfaceBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ProfileBannerMarker"
                                    Grid.Column="0"
                                    CornerRadius="6,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"
                                                Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WorkspaceState}"
                                                         Value="{x:Static vm:DashboardStateKind.Success}">
                                                <Setter Property="Background"
                                                        Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WorkspaceState}"
                                                         Value="{x:Static vm:DashboardStateKind.Error}">
                                                <Setter Property="Background"
                                                        Value="{StaticResource FailureBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WorkspaceState}"
                                                         Value="{x:Static vm:DashboardStateKind.Unavailable}">
                                                <Setter Property="Background"
                                                        Value="{StaticResource BorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="20,16">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding WorkspaceTitle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding WorkspaceMessage}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="16"
                                Style="{StaticResource SurfaceBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                                   Text="Local drafts" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding Profiles.Count, StringFormat={}{0} SAVED}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Padding="12,6"
                                            automation:AutomationProperties.Name="Create a new local profile draft"
                                            Command="{Binding NewDraftCommand}"
                                            Content="New"
                                            Style="{StaticResource BaseButtonStyle}" />
                                </Grid>
                                <ListBox Grid.Row="1"
                                         MinHeight="220"
                                         ItemsSource="{Binding Profiles}"
                                         SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                         DisplayMemberPath="Name" />
                                <TextBlock Grid.Row="2"
                                           Margin="0,12,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Stored for the current Windows user · strict versioned JSON" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="20"
                                Style="{StaticResource SurfaceBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="Draft definition" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="These values are comparison targets, not controls." />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,0,0,18">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource EyebrowTextStyle}"
                                               Text="PROFILE NAME" />
                                    <TextBox automation:AutomationProperties.Name="Profile draft name"
                                             MaxLength="64"
                                             Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Grid Grid.Row="2" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Padding="16"
                                            Background="{StaticResource RaisedSurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <StackPanel>
                                            <CheckBox automation:AutomationProperties.Name="Include battery charge mode in this draft"
                                                      Content="Include battery charge mode"
                                                      IsChecked="{Binding IncludeBattery, Mode=TwoWay}" />
                                            <TextBlock Margin="0,6,0,10"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="Normal, conservation, or rapid charge" />
                                            <ComboBox automation:AutomationProperties.Name="Battery charge mode target"
                                                      DisplayMemberPath="Label"
                                                      IsEnabled="{Binding IncludeBattery}"
                                                      ItemsSource="{Binding BatteryModeOptions}"
                                                      SelectedValue="{Binding SelectedBatteryMode, Mode=TwoWay}"
                                                      SelectedValuePath="Value" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Padding="16"
                                            Background="{StaticResource RaisedSurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <StackPanel>
                                            <CheckBox automation:AutomationProperties.Name="Include thermal mode in this draft"
                                                      Content="Include thermal mode"
                                                      IsChecked="{Binding IncludeThermal, Mode=TwoWay}" />
                                            <TextBlock Margin="0,6,0,10"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="Quiet through custom firmware profiles" />
                                            <ComboBox automation:AutomationProperties.Name="Thermal mode target"
                                                      DisplayMemberPath="Label"
                                                      IsEnabled="{Binding IncludeThermal}"
                                                      ItemsSource="{Binding ThermalModeOptions}"
                                                      SelectedValue="{Binding SelectedThermalMode, Mode=TwoWay}"
                                                      SelectedValuePath="Value" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Margin="0,0,16,0"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="No Apply command exists in this build." />
                                    <Button Grid.Column="1"
                                            Margin="0,0,8,0"
                                            automation:AutomationProperties.Name="Preview draft against typed hardware state"
                                            Command="{Binding PreviewDraftCommand}"
                                            Content="Preview draft"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Grid.Column="2"
                                            Margin="0,0,8,0"
                                            automation:AutomationProperties.Name="Save profile draft locally"
                                            Command="{Binding SaveDraftCommand}"
                                            Content="Save"
                                            Style="{StaticResource BaseButtonStyle}" />
                                    <Button Grid.Column="3"
                                            automation:AutomationProperties.Name="Delete selected local profile draft"
                                            Command="{Binding DeleteDraftCommand}"
                                            Content="Delete"
                                            Style="{StaticResource BaseButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="Typed comparison" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Current values come only from the latest brokered read snapshot." />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Bottom"
                                   Style="{StaticResource EyebrowTextStyle}"
                                   Text="PREVIEW · NEVER EXECUTE" />
                    </Grid>

                    <ItemsControl Grid.Row="4"
                                  ItemsSource="{Binding PreviewItems}"
                                  ItemTemplate="{StaticResource ProfilePreviewItemTemplate}" />
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
