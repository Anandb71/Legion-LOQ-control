<Window x:Class="LegionLoqControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:views="clr-namespace:LegionLoqControl.Views"
        xmlns:vm="clr-namespace:LegionLoqControl.ViewModels"
        Title="Legion + LOQ Control"
        Width="1080"
        Height="760"
        MinWidth="860"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate x:Key="StateCardTemplate"
                      DataType="{x:Type vm:HardwareStateCardViewModel}">
            <Border x:Name="CardRoot"
                    Style="{StaticResource SurfaceBorderStyle}"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="StateMarker"
                            Grid.Column="0"
                            Margin="0,1,0,1"
                            Background="{StaticResource MutedTextBrush}"
                            CornerRadius="2" />

                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource EyebrowTextStyle}"
                                   Text="{Binding Label}" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,4,0,12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Text="{Binding Description}" />
                        <TextBlock Grid.Row="2"
                                   Style="{StaticResource PageTitleTextStyle}"
                                   Text="{Binding Value}" />
                        <TextBlock Grid.Row="3"
                                   Margin="0,8,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding Detail}" />
                        <ItemsControl Grid.Row="4"
                                      Margin="0,12,0,0"
                                      ItemsSource="{Binding Options}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HardwareStateOptionViewModel}">
                                    <Button Padding="12,6"
                                            automation:AutomationProperties.Name="{Binding Label, StringFormat=Apply {0}}"
                                            Command="{Binding DataContext.ApplyOptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Token}"
                                            Content="{Binding Label}"
                                            IsEnabled="{Binding DataContext.CanApply, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource ChipButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                <Binding Path="Label" />
                                                                <Binding Path="Token" />
                                                                <Binding Path="DataContext.Value"
                                                                         RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Background"
                                                                Value="{StaticResource ActionBrush}" />
                                                        <Setter Property="BorderBrush"
                                                                Value="{StaticResource ActionBrush}" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource ActionTextBrush}" />
                                                        <Setter Property="Tag"
                                                                Value="accent" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Success}">
                    <Setter TargetName="StateMarker"
                            Property="Background"
                            Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Warning}">
                    <Setter TargetName="StateMarker"
                            Property="Background"
                            Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Error}">
                    <Setter TargetName="StateMarker"
                            Property="Background"
                            Value="{StaticResource FailureBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Unavailable}">
                    <Setter TargetName="StateMarker"
                            Property="Background"
                            Value="{StaticResource BorderBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="CapabilityItemTemplate"
                      DataType="{x:Type vm:CapabilityItemViewModel}">
            <StackPanel>
            <Grid Margin="0,10,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock Margin="0,3,16,0"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding EvidenceCode}" />
                </StackPanel>
                <TextBlock x:Name="SupportText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Style="{StaticResource EyebrowTextStyle}"
                           Text="{Binding Support}" />
            </Grid>
            <Border Style="{StaticResource ThinSeparatorStyle}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Success}">
                    <Setter TargetName="SupportText"
                            Property="Foreground"
                            Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Warning}">
                    <Setter TargetName="SupportText"
                            Property="Foreground"
                            Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ProfilePreviewItemTemplate"
                      DataType="{x:Type vm:ProfilePreviewItemViewModel}">
            <Border Margin="0,0,0,8"
                    Padding="16,14"
                    Style="{StaticResource SurfaceBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="PreviewMarker"
                            Grid.Column="0"
                            Margin="0,1,0,1"
                            Background="{StaticResource MutedTextBrush}"
                            CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="14,0,20,0">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Feature}" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding Detail}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource EyebrowTextStyle}"
                                   Text="CURRENT" />
                        <TextBlock Margin="0,3,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding Current}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3"
                               Margin="16,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="→" />
                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource EyebrowTextStyle}"
                                   Text="DRAFT" />
                        <TextBlock Margin="0,3,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding Desired}" />
                    </StackPanel>
                    <TextBlock x:Name="PreviewStatus"
                               Grid.Column="5"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource EyebrowTextStyle}"
                               Text="{Binding Status}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Success}">
                    <Setter TargetName="PreviewMarker"
                            Property="Background"
                            Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="PreviewStatus"
                            Property="Foreground"
                            Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Warning}">
                    <Setter TargetName="PreviewMarker"
                            Property="Background"
                            Value="{StaticResource WarningBrush}" />
                    <Setter TargetName="PreviewStatus"
                            Property="Foreground"
                            Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Error}">
                    <Setter TargetName="PreviewMarker"
                            Property="Background"
                            Value="{StaticResource FailureBrush}" />
                    <Setter TargetName="PreviewStatus"
                            Property="Foreground"
                            Value="{StaticResource FailureBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}"
                             Value="{x:Static vm:DashboardStateKind.Unavailable}">
                    <Setter TargetName="PreviewMarker"
                            Property="Background"
                            Value="{StaticResource BorderBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <TabControl automation:AutomationProperties.Name="Primary application navigation"
                Background="{StaticResource CanvasBrush}"
                BorderThickness="0">
        <TabItem Header="DASHBOARD"
                 Style="{StaticResource NavigationTabItemStyle}">
            <ScrollViewer Background="{StaticResource CanvasBrush}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24,32,28"
              Background="{StaticResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="ProductMark"
                           Width="32"
                           Height="32"
                           Margin="0,8,12,0"
                           VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" />
                    <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}"
                               Text="LEGION + LOQ CONTROL / LIVE HARDWARE SESSION" />
                    <StackPanel Margin="0,6,0,0"
                                automation:AutomationProperties.AutomationId="readme-redact"
                                automation:AutomationProperties.Name="Serial-free device identity">
                    <TextBlock Style="{StaticResource PageTitleTextStyle}"
                               automation:AutomationProperties.AutomationId="readme-redact"
                               Text="{Binding DeviceName}" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               automation:AutomationProperties.AutomationId="readme-redact"
                               Text="{Binding DeviceMetadata}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            MaxWidth="280"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Border HorizontalAlignment="Right"
                            Style="{StaticResource StatusBadgeBorderStyle}">
                        <TextBlock Style="{StaticResource EyebrowTextStyle}"
                                   Text="LOCAL · NO TELEMETRY" />
                    </Border>
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding InventoryStatus}" />
                    <TextBlock Margin="0,4,0,0"
                               HorizontalAlignment="Right"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding BrokerInstallStatus}"
                               TextAlignment="Right"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,16,0,0"
                        Padding="16,12"
                        Style="{StaticResource SurfaceBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="POWER" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource InstrumentValueTextStyle}"
                                       Text="{Binding PowerSourceLabel}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Width="1"
                                Margin="0,2"
                                Background="{StaticResource BorderBrush}" />
                        <StackPanel Grid.Column="2" Margin="12,0">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="CHARGE" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource InstrumentValueTextStyle}"
                                       Text="{Binding ChargeLabel}" />
                        </StackPanel>
                        <Border Grid.Column="3"
                                Width="1"
                                Margin="0,2"
                                Background="{StaticResource BorderBrush}" />
                        <StackPanel Grid.Column="4" Margin="12,0">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="MODE" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource InstrumentValueTextStyle}"
                                       Text="{Binding ChargingModeLabel}" />
                        </StackPanel>
                        <Border Grid.Column="5"
                                Width="1"
                                Margin="0,2"
                                Background="{StaticResource BorderBrush}" />
                        <StackPanel Grid.Column="6" Margin="12,0">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="CPU" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource InstrumentValueTextStyle}"
                                       Text="{Binding CpuLabel}" />
                        </StackPanel>
                        <Border Grid.Column="7"
                                Width="1"
                                Margin="0,2"
                                Background="{StaticResource BorderBrush}" />
                        <StackPanel Grid.Column="8" Margin="12,0">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="RAM" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource InstrumentValueTextStyle}"
                                       Text="{Binding MemoryLabel}" />
                        </StackPanel>
                        <Border Grid.Column="9"
                                Width="1"
                                Margin="0,2"
                                Background="{StaticResource BorderBrush}" />
                        <StackPanel Grid.Column="10" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="DISK" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource InstrumentValueTextStyle}"
                                       Text="{Binding DiskLabel}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,0,0,28"
                    Style="{StaticResource SurfaceBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BannerMarker"
                            Grid.Column="0"
                            CornerRadius="6,0,0,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background"
                                        Value="{StaticResource WarningBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BannerState}"
                                                 Value="{x:Static vm:DashboardStateKind.Success}">
                                        <Setter Property="Background"
                                                Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BannerState}"
                                                 Value="{x:Static vm:DashboardStateKind.Error}">
                                        <Setter Property="Background"
                                                Value="{StaticResource FailureBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,16">
                        <TextBlock FontFamily="{StaticResource DisplayFont}"
                                   FontWeight="SemiBold"
                                   Text="{Binding BannerTitle}" />
                        <TextBlock Margin="0,4,16,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding BannerMessage}" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Margin="16"
                            VerticalAlignment="Center"
                            automation:AutomationProperties.Name="Read current hardware state using the elevated broker"
                            Command="{Binding RefreshHardwareStateCommand}"
                            Content="{Binding RefreshButtonText}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="Refreshes hardware through the session broker" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                               Text="Current hardware state" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Click a value to apply it. The broker reads live firmware first, so you do not need to refresh." />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Bottom"
                           Style="{StaticResource EyebrowTextStyle}"
                           Text="{Binding LastUpdated, StringFormat=LAST VERIFIED · {0}}" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,6,6"
                                Content="{Binding Battery}"
                                ContentTemplate="{StaticResource StateCardTemplate}" />
                <ContentControl Grid.Row="0"
                                Grid.Column="1"
                                Margin="6,0,0,6"
                                Content="{Binding Thermal}"
                                ContentTemplate="{StaticResource StateCardTemplate}" />
                <ContentControl Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,6,6,0"
                                Content="{Binding DisplayOverdrive}"
                                ContentTemplate="{StaticResource StateCardTemplate}" />
                <ContentControl Grid.Row="1"
                                Grid.Column="1"
                                Margin="6,6,0,0"
                                Content="{Binding IntegratedGpu}"
                                ContentTemplate="{StaticResource StateCardTemplate}" />
                <ContentControl Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,12,0,0"
                                Content="{Binding Keyboard}"
                                ContentTemplate="{StaticResource StateCardTemplate}" />
                <ContentControl Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,12,0,0"
                                Content="{Binding Fans}"
                                ContentTemplate="{StaticResource StateCardTemplate}" />
            </Grid>

            <Border Grid.Row="4"
                    Padding="20,18"
                    Style="{StaticResource SurfaceBorderStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="Capability evidence" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Candidate means an interface exists; it does not claim verified support." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource EyebrowTextStyle}"
                                       Text="SERIAL-FREE INVENTORY" />
                            <Button Margin="0,8,0,0"
                                    Padding="14,7"
                                    HorizontalAlignment="Right"
                                    automation:AutomationProperties.Name="Export redacted diagnostics to a JSON file"
                                    Command="{Binding DiagnosticsExport.ExportCommand}"
                                    Content="{Binding DiagnosticsExport.ButtonText}"
                                    Style="{StaticResource BaseButtonStyle}"
                                    ToolTip="Exports retained snapshots without starting a hardware read or elevation" />
                            <TextBlock MaxWidth="320"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Right"
                                       automation:AutomationProperties.LiveSetting="Polite"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding DiagnosticsExport.StatusMessage}"
                                       TextAlignment="Right"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource ThinSeparatorStyle}" />

                    <ItemsControl ItemsSource="{Binding Capabilities}"
                                  ItemTemplate="{StaticResource CapabilityItemTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,24,0" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="POWER"
                 Style="{StaticResource NavigationTabItemStyle}">
            <views:PowerWorkspaceView />
        </TabItem>
        <TabItem Header="INPUT"
                 Style="{StaticResource NavigationTabItemStyle}">
            <views:InputWorkspaceView />
        </TabItem>
        <TabItem Header="LIGHTING"
                 Style="{StaticResource NavigationTabItemStyle}">
            <views:LightingWorkspaceView />
        </TabItem>
        <TabItem Header="DISPLAY"
                 Style="{StaticResource NavigationTabItemStyle}">
            <views:DisplayWorkspaceView />
        </TabItem>
        <TabItem Header="DEVICE"
                 Style="{StaticResource NavigationTabItemStyle}">
            <views:DeviceWorkspaceView />
        </TabItem>

        <TabItem Header="PROFILE"
                 Style="{StaticResource NavigationTabItemStyle}">
            <ScrollViewer Background="{StaticResource CanvasBrush}"
                          DataContext="{Binding ProfileWorkspace}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="32,24,32,28"
                      Background="{StaticResource CanvasBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource EyebrowTextStyle}"
                                       Text="PROFILE PREVIEW / APPLY WOULD-CHANGE TARGETS" />
                            <StackPanel Margin="0,6,0,0"
                                        automation:AutomationProperties.AutomationId="readme-redact"
                                        automation:AutomationProperties.Name="Serial-free device identity">
                            <TextBlock Style="{StaticResource PageTitleTextStyle}"
                                       automation:AutomationProperties.AutomationId="readme-redact"
                                       Text="{Binding DataContext.DeviceName, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       automation:AutomationProperties.AutomationId="readme-redact"
                                       Text="{Binding DataContext.DeviceMetadata, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource EyebrowTextStyle}"
                                       Text="LOCAL DRAFTS · SESSION BROKER" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Apply uses the session broker for would-change targets" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,0,0,28"
                            Style="{StaticResource SurfaceBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ProfileBannerMarker"
                                    Grid.Column="0"
                                    CornerRadius="6,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background"
                                                Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WorkspaceState}"
                                                         Value="{x:Static vm:DashboardStateKind.Success}">
                                                <Setter Property="Background"
                                                        Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WorkspaceState}"
                                                         Value="{x:Static vm:DashboardStateKind.Error}">
                                                <Setter Property="Background"
                                                        Value="{StaticResource FailureBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WorkspaceState}"
                                                         Value="{x:Static vm:DashboardStateKind.Unavailable}">
                                                <Setter Property="Background"
                                                        Value="{StaticResource BorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="20,16">
                                <TextBlock FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="SemiBold"
                                           Text="{Binding WorkspaceTitle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding WorkspaceMessage}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="16"
                                Style="{StaticResource SurfaceBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                                   Text="Local drafts" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding Profiles.Count, StringFormat={}{0} SAVED}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Padding="12,6"
                                            automation:AutomationProperties.Name="Create a new local profile draft"
                                            Command="{Binding NewDraftCommand}"
                                            Content="New"
                                            Style="{StaticResource BaseButtonStyle}" />
                                </Grid>
                                <ListBox Grid.Row="1"
                                         MinHeight="220"
                                         automation:AutomationProperties.Name="Saved local profile drafts"
                                         ItemsSource="{Binding Profiles}"
                                         SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                         DisplayMemberPath="Name" />
                                <TextBlock Grid.Row="2"
                                           Margin="0,12,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Stored for the current Windows user · strict versioned JSON" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="20"
                                Style="{StaticResource SurfaceBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                                    <TextBlock Style="{StaticResource SectionTitleStyle}"
                                               Text="Draft definition" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="These values are comparison targets, not controls." />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,0,0,18">
                                    <TextBlock Margin="0,0,0,6"
                                               Style="{StaticResource EyebrowTextStyle}"
                                               Text="PROFILE NAME" />
                                    <TextBox automation:AutomationProperties.Name="Profile draft name"
                                             MaxLength="64"
                                             Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <Grid Grid.Row="2" Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Padding="16"
                                            Background="{StaticResource RaisedSurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <StackPanel>
                                            <CheckBox automation:AutomationProperties.Name="Include battery charge mode in this draft"
                                                      Content="Include battery charge mode"
                                                      IsChecked="{Binding IncludeBattery, Mode=TwoWay}" />
                                            <TextBlock Margin="0,6,0,10"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="Normal, conservation, or rapid charge" />
                                            <ComboBox automation:AutomationProperties.Name="Battery charge mode target"
                                                      DisplayMemberPath="Label"
                                                      IsEnabled="{Binding IncludeBattery}"
                                                      ItemsSource="{Binding BatteryModeOptions}"
                                                      SelectedValue="{Binding SelectedBatteryMode, Mode=TwoWay}"
                                                      SelectedValuePath="Value" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Padding="16"
                                            Background="{StaticResource RaisedSurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <StackPanel>
                                            <CheckBox automation:AutomationProperties.Name="Include thermal mode in this draft"
                                                      Content="Include thermal mode"
                                                      IsChecked="{Binding IncludeThermal, Mode=TwoWay}" />
                                            <TextBlock Margin="0,6,0,10"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="Quiet through custom firmware profiles" />
                                            <ComboBox automation:AutomationProperties.Name="Thermal mode target"
                                                      DisplayMemberPath="Label"
                                                      IsEnabled="{Binding IncludeThermal}"
                                                      ItemsSource="{Binding ThermalModeOptions}"
                                                      SelectedValue="{Binding SelectedThermalMode, Mode=TwoWay}"
                                                      SelectedValuePath="Value" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Margin="0,0,16,0"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Apply uses the session broker for would-change battery and thermal targets." />
                                    <Button Grid.Column="1"
                                            Margin="0,0,8,0"
                                            automation:AutomationProperties.Name="Preview draft against typed hardware state"
                                            Command="{Binding PreviewDraftCommand}"
                                            Content="Preview draft"
                                            Style="{StaticResource BaseButtonStyle}" />
                                    <Button Grid.Column="2"
                                            Margin="0,0,8,0"
                                            automation:AutomationProperties.Name="Apply would-change profile targets through the session broker"
                                            Command="{Binding ApplyProfileCommand}"
                                            Content="Apply"
                                            Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button Grid.Column="3"
                                            Margin="0,0,8,0"
                                            automation:AutomationProperties.Name="Save profile draft locally"
                                            Command="{Binding SaveDraftCommand}"
                                            Content="Save"
                                            Style="{StaticResource BaseButtonStyle}" />
                                    <Button Grid.Column="4"
                                            automation:AutomationProperties.Name="Delete selected local profile draft"
                                            Command="{Binding DeleteDraftCommand}"
                                            Content="Delete"
                                            Style="{StaticResource BaseButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="Typed comparison" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Current values come only from the latest brokered read snapshot." />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Bottom"
                                   Style="{StaticResource EyebrowTextStyle}"
                                   Text="PREVIEW · NEVER EXECUTE" />
                    </Grid>

                    <ItemsControl Grid.Row="4"
                                  ItemsSource="{Binding PreviewItems}"
                                  ItemTemplate="{StaticResource ProfilePreviewItemTemplate}" />
                </Grid>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="AUTOMATION"
                 Style="{StaticResource NavigationTabItemStyle}">
            <views:AutomationWorkspaceView DataContext="{Binding AutomationWorkspace}" />
        </TabItem>
    </TabControl>
</Window>
