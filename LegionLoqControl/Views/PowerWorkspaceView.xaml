<UserControl x:Class="LegionLoqControl.Views.PowerWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <ScrollViewer Background="{StaticResource CanvasBrush}"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,28">
            <TextBlock Style="{StaticResource EyebrowTextStyle}"
                       Text="POWER / CHARGING AND COOLING" />
            <TextBlock Margin="0,6,0,8"
                       Style="{StaticResource PageTitleTextStyle}"
                       Text="Power" />
            <TextBlock Margin="0,0,0,20"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Live charge, firmware charge mode, overnight charge, Always-on USB, and the OEM fan table. No warranty, serial, or invented conservation graph." />

            <Border Margin="0,0,0,20"
                    Padding="16,12"
                    Style="{StaticResource SurfaceBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="POWER" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource InstrumentValueTextStyle}"
                                   Text="{Binding PowerSourceLabel}" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Width="1"
                            Margin="0,2"
                            Background="{StaticResource BorderBrush}" />
                    <StackPanel Grid.Column="2" Margin="12,0">
                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="CHARGE" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource InstrumentValueTextStyle}"
                                   Text="{Binding ChargeLabel}" />
                    </StackPanel>
                    <Border Grid.Column="3"
                            Width="1"
                            Margin="0,2"
                            Background="{StaticResource BorderBrush}" />
                    <StackPanel Grid.Column="4" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="CHARGING MODE" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource InstrumentValueTextStyle}"
                                   Text="{Binding ChargingModeLabel}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Margin="0,0,0,12"
                            Content="{Binding Battery}"
                            ContentTemplate="{DynamicResource StateCardTemplate}" />
            <ContentControl Margin="0,0,0,12"
                            Content="{Binding OvernightCharge}"
                            ContentTemplate="{DynamicResource StateCardTemplate}"
                            Visibility="{Binding OvernightCharge.IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <ContentControl Margin="0,0,0,12"
                            Content="{Binding AlwaysOnUsb}"
                            ContentTemplate="{DynamicResource StateCardTemplate}"
                            Visibility="{Binding AlwaysOnUsb.IsAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Border Margin="0,0,0,12"
                    Padding="20"
                    Style="{StaticResource SurfaceBorderStyle}"
                    Visibility="{Binding FanCurveWorkspace.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="FAN CURVE" />
                    <TextBlock Margin="0,4,0,16"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Speeds are 0–255. Sensor thresholds stay on the OEM snapshot. Full-speed is omitted on this BIOS." />
                    <ItemsControl ItemsSource="{Binding FanCurveWorkspace.Points}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding Index, StringFormat=Point {0}}" />
                                    <TextBox Grid.Column="1"
                                             automation:AutomationProperties.Name="{Binding SpeedName}"
                                             Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Column="2"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding Sensor, StringFormat=Sensor {0}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                automation:AutomationProperties.Name="Apply the edited fan curve through the session broker"
                                Command="{Binding FanCurveWorkspace.ApplyFanCurveCommand}"
                                Content="Apply curve"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button automation:AutomationProperties.Name="Restore the OEM fan table through the session broker"
                                Command="{Binding FanCurveWorkspace.ApplyOemFanTableCommand}"
                                Content="Restore OEM"
                                Style="{StaticResource BaseButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button HorizontalAlignment="Left"
                    automation:AutomationProperties.Name="Open Windows Power and sleep settings"
                    Command="{Binding OpenWindowsSettingsCommand}"
                    CommandParameter="ms-settings:powersleep"
                    Content="Windows Power &amp; sleep"
                    Style="{StaticResource BaseButtonStyle}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
