<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LegionLoqControl.Application\LegionLoqControl.Application.csproj" />
    <ProjectReference Include="..\..\src\LegionLoqControl.Contracts\LegionLoqControl.Contracts.csproj" />
    <ProjectReference Include="..\..\src\LegionLoqControl.Domain\LegionLoqControl.Domain.csproj" />
    <ProjectReference Include="..\..\src\LegionLoqControl.Infrastructure.Windows\LegionLoqControl.Infrastructure.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\hardware-evidence\**\*.json">
      <Link>hardware-evidence\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
